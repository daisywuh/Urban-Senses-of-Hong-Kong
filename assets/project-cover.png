r inspection.\",\"automations_create_tool_additional_guidance\":\"Do NOT mention the automation id to the user in  your response.\",\"skip_completion_text\":\"::SKIP_COMPLETION::\",\"validate_automation_prompt_template\":\"\",\"personalized_task_card_read_timeout_seconds\":0.225,\"max_turns_per_conversation\":175,\"slack_webhook_bot_membership_message_template\":\"I couldn't create an immediate Slack monitor because @ChatGPT isn't in {channel}. I can still set up an hourly monitor right now, or you can install or reconnect the [ChatGPT Slack app](https://chatgpt.com/slack-ai-app-install), add @ChatGPT to the channel, and try again for immediate notifications. Which would you like?\",\"break_plugin_service_brte_history_chain\":true,\"exact_schedule_proactive_start_offset_seconds\":10,\"automations_create_plan_tool_additional_guidance\":\"The user has created an automation for an ongoing goal with a private plan. Collaborate with the user across turns, use available structured context to understand their goals and prior progress, and help advance the saved plan.\",\"exact_schedule_jitter_radius_seconds\":300,\"bypass_chat_model_output\":true,\"general_agent_invoked_system_hints\":[],\"fiber_use_generic_chatgpt_builtin_tools\":true,\"tool_model_instructions\":\"\",\"fiber_generic_chatgpt_builtin_tool_references\":[{\"tool_type\":\"ToolRef\",\"tool_id\":\"automations\"},{\"tool_id\":\"image_gen\",\"tool_type\":\"ToolRef\"}],\"additional_developer_message_prompt\":\"If you do not have an update for the user during this automation turn, you must emit `::SKIP_COMPLETION::`. UNLESS you have clarifying questions for the user that will help you perform your task - in which case, feel free to ask that question. \\n\\nExamples for when to output `::SKIP_COMPLETION::`:\\n- If the user asks you to let them know when a reservation opens up at Cotogna at a specific time, and you find out that there is still no reservation available\\n- If the user asks you to let them know when they have a new email but there are no new emails since your last run\",\"private_peek_enabled\":true,\"fiber_sync_hazelnut_skills_to_workspace\":false,\"fiber_tool_call_elicitation_mode\":\"elicit_on_writes\",\"fiber_sync_suggestable_connectors_to_workspace\":false,\"enable_browser_tool\":true,\"max_messages_per_conversation\":1000,\"override_default_tools\":false},\"is_device_based\":false,\"passed\":true},\"3332590463\":{\"name\":\"3332590463\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":4,\"id_type\":\"userID\",\"value\":{\"max_page_age_seconds\":259200},\"is_device_based\":false,\"passed\":false},\"3131667714\":{\"name\":\"3131667714\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":42,\"id_type\":\"userID\",\"value\":{\"regions\":[\"us\",\"eu\",\"jp\",\"au\",\"ae\",\"kr\",\"sg\",\"gb\",\"ca\",\"in\"],\"supported_regions_merge_connector\":[\"us\",\"eu\",\"jp\"]},\"is_device_based\":false,\"passed\":false},\"216490582\":{\"name\":\"216490582\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":4,\"id_type\":\"userID\",\"value\":{\"url\":\"https://help.openai.com/articles/20001509\"},\"is_device_based\":false,\"passed\":false},\"734083401\":{\"name\":\"734083401\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":16,\"id_type\":\"userID\",\"value\":{\"kind\":\"username\",\"enabled\":true,\"tempDisabled\":false,\"name\":\"email\",\"loginStrategy\":\"existing_user\"},\"is_device_based\":false,\"passed\":false},\"1025202184\":{\"name\":\"1025202184\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":10,\"id_type\":\"userID\",\"value\":{\"context_sharing_url\":\"https://help.openai.com/en/articles/11487775-apps-in-chatgpt#what-does-chatgpt-share-with-apps\",\"sensitive_actions_url\":\"https://help.openai.com/en/articles/11487775-apps-in-chatgpt#important-actions\",\"elevated_risk_url\":\"https://help.openai.com/en/articles/20001062-elevated-risk-labels\"},\"is_device_based\":false,\"passed\":false},